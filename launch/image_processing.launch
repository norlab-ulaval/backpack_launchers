<launch>
	<!-- RESIZE FOR VISUALIZATION -->
        <arg name="enable_debayer" default="true" />
        <arg name="enable_resize" default="true" />
    	<arg name="resize_factor" default="0.25"/>

        <node if="$(arg enable_resize)" name="stereo_camera1_manager" pkg="nodelet" type="nodelet" args="manager" >
                <param name="num_worker_threads" value="3" type="int"/>
        </node>
	<node if="$(arg enable_debayer)" pkg="nodelet" type="nodelet" name="stereo_debayer_camera1" args="load image_proc/debayer stereo_camera1_manager">
                <param name="bayer_pattern" value="rggb"/>
                <remap from="image_raw" to="/stereo/camera1/image"/>
                <remap from="camera_info" to="/stereo/camera1/camera_info"/>
                <remap from="image_color" to="/stereo/camera1/debayer/image"/>
                <remap from="image_mono" to="/stereo/camera1/debayer/image_mono"/>
        </node>

        <node if="$(arg enable_resize)" pkg="nodelet" type="nodelet" name="stereo_resize_camera1" args="load image_proc/resize stereo_camera1_manager">
                <param name="scale_width" value="$(arg resize_factor)"/>
        	<param name="scale_height" value="$(arg resize_factor)"/>
        	<remap from="image" to="/stereo/camera1/debayer/image"/>
                <remap from="camera_info" to="/stereo/camera1/camera_info"/>
                <remap from="~image" to="/stereo/camera1/resized/image"/>
                <remap from="camera_info" to="/stereo/camera1/resized/camera_info"/>
    	</node>

    	<node if="$(arg enable_resize)" name="stereo_camera2_manager" pkg="nodelet" type="nodelet" args="manager" >
                <param name="num_worker_threads" value="3" type="int"/>
        </node>
	<node if="$(arg enable_debayer)" pkg="nodelet" type="nodelet" name="stereo_debayer_camera2" args="load image_proc/debayer stereo_camera2_manager">
                <param name="bayer_pattern" value="rggb"/>
                <remap from="image_raw" to="/stereo/camera2/image"/>
                <remap from="camera_info" to="/stereo/camera2/camera_info"/>
                <remap from="image_color" to="/stereo/camera2/debayer/image"/>
                <remap from="image_mono" to="/stereo/camera2/debayer/image_mono"/>
        </node>

        <node if="$(arg enable_resize)" pkg="nodelet" type="nodelet" name="stereo_resize_camera2" args="load image_proc/resize stereo_camera2_manager">
                <param name="scale_width" value="$(arg resize_factor)"/>
                <param name="scale_height" value="$(arg resize_factor)"/>
                <remap from="image" to="/stereo/camera2/debayer/image"/>
                <remap from="camera_info" to="/stereo/camera2/camera_info"/>
                <remap from="~image" to="/stereo/camera2/resized/image"/>
                <remap from="camera_info" to="/stereo/camera2/resized/camera_info"/>
    	</node>
</launch>
